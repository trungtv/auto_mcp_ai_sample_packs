{
  "name": "@auto-mcp/site-adapter-jira",
  "version": "0.1.0",
  "private": false,
  "description": "Sample site pack — Jira Cloud for auto_mcp_ai",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test dist/formatters.test.js dist/pipeline.integration.test.js"
  },
  "dependencies": {
    "@auto-mcp/shared": "workspace:*",
    "@auto-mcp/site-adapters": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  }
}
